# Track only resume-build sources; ignore everything else in this dir
# (personal notes, archives, working files) by default.
/*

!/base.yaml
!/render.sh
!/merge.py
!/pixi.toml
!/pixi.lock
!/CLAUDE.md
!/.gitignore
!/.gitattributes
!/README.md

# Profiles directory: track the overlay YAMLs only.
!/profiles/
/profiles/*
!/profiles/*.yaml

# Contribution updater automation.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
!/scripts/
/scripts/*
!/scripts/*.py
!/tests/
/tests/*
!/tests/*.py

# Build output is distributed via releases, never committed.
out/
.build/
rendercv_output/

# Python caches
__pycache__/
*.pyc
